{
  "name": "fstudy",
  "private": true,
  "packageManager": "pnpm@11.28.4",
  "scripts": {
    "dev": "pnpm --filter @fstudy/api dev",
    "admin:dev": "python3 -m http.server 8081 --bind 127.0.0.1 --directory apps/admin",
    "build": "pnpm --filter @fstudy/api build",
    "check": "pnpm --filter @fstudy/api check",
    "knowledge:check": "node scripts/knowledge-check.mjs --strict",
    "test": "pnpm --filter @fstudy/api test && node --test tests/admin.test.mjs",
    "test:admin": "node --test tests/admin.test.mjs",
    "db:migrate:local": "pnpm --filter @fstudy/api db:migrate:local",
    "db:migrate:remote": "pnpm --filter @fstudy/api db:migrate:remote"
  }
}
