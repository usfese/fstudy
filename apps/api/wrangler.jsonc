{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fstudy-api",
  "main": "src/entrypoints/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "fstudy-api.usfese.cc",
      "custom_domain": true
    }
  ],
  "vars": {
    "INVITE_REGISTRATION_ENABLED": "true",
    "CAS_LOGIN_ENABLED": "false",
    "ALLOWED_ORIGINS": "https://fstudy.usfese.cc,https://fstudy-admin.usfese.cc"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fstudy",
      "database_id": "a0fb31d4-6d34-42db-9895-daf724d8bd25",
      "migrations_dir": "migrations"
    }
  ]
}
