{
  "name": "@fstudy/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/entrypoints/node.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply fstudy --local",
    "db:migrate:remote": "wrangler d1 migrations apply fstudy --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.7.5",
    "hono": "^4.13.13",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/node": "^24.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.45.0"
  }
}
